# Absolute path is safest for cron. A relative path is resolved from this repo.
RESUME_PATH=resumes/resume.pdf

# Optional. Leave unset to use state/naukri-storage-state.json.
# NAUKRI_STATE_PATH=/absolute/path/to/naukri-storage-state.json

# Naukri blocks its profile page in headless Chromium. Keep this false and use
# npm run update:server under Xvfb for AWS cron.
HEADLESS=false

# Use the regular Google Chrome browser rather than Playwright's headless shell.
BROWSER_CHANNEL=chrome
